---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>By Elias, Oli & Georgia</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Crimson+Pro:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
 
    :root {
      --yellow: #FFE135;
      --coral: #FF4D4D;
      --teal: #00C2B2;
      --ink: #0D0D0D;
      --white: #FAFAF5;
    }
 
    html { scroll-behavior: smooth; }
 
    body {
      background-color: var(--ink);
      color: var(--white);
      font-family: 'Crimson Pro', Georgia, serif;
      min-height: 100vh;
      overflow-x: hidden;
    }
 
    /* ── HERO ── */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 2rem;
      position: relative;
      overflow: hidden;
    }
 
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 50% at 20% 30%, rgba(255,77,77,0.25) 0%, transparent 70%),
        radial-gradient(ellipse 50% 60% at 80% 70%, rgba(0,194,178,0.2) 0%, transparent 70%),
        radial-gradient(ellipse 40% 40% at 50% 50%, rgba(255,225,53,0.1) 0%, transparent 70%);
      z-index: 0;
    }
 
    .hero-content {
      position: relative;
      z-index: 1;
    }
 
    .byline {
      font-family: 'Crimson Pro', Georgia, serif;
      font-weight: 300;
      font-style: italic;
      font-size: clamp(1rem, 3vw, 1.4rem);
      letter-spacing: 0.25em;
      color: var(--yellow);
      text-transform: uppercase;
      margin-bottom: 1.2rem;
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 0.2s;
    }
 
    .hero-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(4rem, 18vw, 16rem);
      line-height: 0.88;
      letter-spacing: 0.02em;
      color: var(--white);
      opacity: 0;
      animation: fadeUp 0.9s ease forwards 0.45s;
    }
 
    .hero-title .name-elias { color: var(--coral); }
    .hero-title .name-georgia { color: var(--teal); }
 
    .ampersand {
      display: inline-block;
      color: var(--yellow);
      font-size: 0.7em;
      vertical-align: middle;
      padding: 0 0.1em;
    }
 
    .hero-sub {
      margin-top: 2.5rem;
      font-size: clamp(1rem, 2.5vw, 1.25rem);
      font-weight: 300;
      color: rgba(250,250,245,0.6);
      letter-spacing: 0.08em;
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 0.7s;
    }
 
    .scroll-hint {
      position: absolute;
      bottom: 2.5rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 1.1s;
    }
 
    .scroll-hint span {
      font-size: 0.7rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: rgba(250,250,245,0.4);
    }
 
    .scroll-line {
      width: 1px;
      height: 3rem;
      background: linear-gradient(to bottom, var(--yellow), transparent);
      animation: scrollPulse 2s ease-in-out infinite;
    }
 
    /* ── DIVIDER ── */
    .divider {
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, var(--coral), var(--yellow), var(--teal));
    }
 
    /* ── CONTACT ── */
    .contact-section {
      padding: clamp(4rem, 10vw, 8rem) clamp(1.5rem, 6vw, 4rem);
      max-width: 680px;
      margin: 0 auto;
    }
 
    .section-label {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(0.75rem, 2vw, 0.9rem);
      letter-spacing: 0.4em;
      color: var(--yellow);
      margin-bottom: 1rem;
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 0.1s;
      animation-play-state: paused;
    }
 
    .section-heading {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 10vw, 7rem);
      line-height: 0.9;
      margin-bottom: 1.5rem;
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 0.25s;
      animation-play-state: paused;
    }
 
    .section-heading .accent { color: var(--coral); }
 
    .section-intro {
      font-size: clamp(1rem, 2.5vw, 1.2rem);
      font-weight: 300;
      line-height: 1.7;
      color: rgba(250,250,245,0.65);
      margin-bottom: 3rem;
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 0.4s;
      animation-play-state: paused;
    }
 
    .contact-section.visible .section-label,
    .contact-section.visible .section-heading,
    .contact-section.visible .section-intro { animation-play-state: running; }
 
    .contact-form { display: flex; flex-direction: column; gap: 1.5rem; }
 
    .field { display: flex; flex-direction: column; gap: 0.5rem; }
 
    .field label {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 0.85rem;
      letter-spacing: 0.25em;
      color: rgba(250,250,245,0.5);
    }
 
    .field input,
    .field textarea {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 4px;
      padding: 1rem 1.25rem;
      color: var(--white);
      font-family: 'Crimson Pro', Georgia, serif;
      font-size: 1.05rem;
      font-weight: 300;
      outline: none;
      transition: border-color 0.2s, background 0.2s;
      resize: none;
    }
 
    .field input:focus,
    .field textarea:focus {
      border-color: var(--yellow);
      background: rgba(255,225,53,0.04);
    }
 
    .field input::placeholder,
    .field textarea::placeholder { color: rgba(250,250,245,0.25); }
 
    .submit-btn {
      align-self: flex-start;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.1rem;
      letter-spacing: 0.2em;
      padding: 1rem 2.5rem;
      background: var(--yellow);
      color: var(--ink);
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: transform 0.15s, background 0.15s;
    }
 
    .submit-btn:hover { background: var(--coral); color: var(--white); transform: translateY(-2px); }
    .submit-btn:active { transform: translateY(0); }
 
    .form-success {
      display: none;
      padding: 1.5rem;
      border: 1px solid var(--teal);
      border-radius: 4px;
      color: var(--teal);
      font-size: 1.1rem;
      font-weight: 300;
      letter-spacing: 0.05em;
    }
 
    /* ── FOOTER ── */
    footer {
      text-align: center;
      padding: 3rem 2rem;
      border-top: 1px solid rgba(255,255,255,0.07);
      font-size: 0.85rem;
      letter-spacing: 0.15em;
      color: rgba(250,250,245,0.25);
    }
 
    footer strong { color: var(--yellow); font-weight: 400; }
 
    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
 
    @keyframes scrollPulse {
      0%, 100% { opacity: 0.4; }
      50%       { opacity: 1; }
    }
  </style>
</head>
<body>
 
  <!-- HERO -->
  <section class="hero">
    <div class="hero-content">
      <p class="byline">A page by</p>
      <h1 class="hero-title">
        <span class="name-elias">Elias</span><br>
        <span class="ampersand">&</span> Oli<br>
        <span class="ampersand">&</span> <span class="name-georgia">Georgia</span>
      </h1>
      <p class="hero-sub">Say hello — we'd love to hear from you.</p>
    </div>
    <div class="scroll-hint">
      <span>Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </section>
 
  <div class="divider"></div>
 
  <!-- CONTACT -->
  <section class="contact-section" id="contact">
    <p class="section-label">Get in touch</p>
    <h2 class="section-heading">Send us a <span class="accent">message.</span></h2>
    <p class="section-intro">We read everything. Drop us a note and one of us will get back to you.</p>
 
    <!-- Replace YOUR_FORM_ID with your Formspree form ID -->
    <form
      class="contact-form"
      action="https://formspree.io/f/xdajgrnj"
      method="POST"
      id="contactForm"
    >
      <div class="field">
        <label for="name">Your Name</label>
        <input type="text" id="name" name="name" placeholder="Who's writing?" required />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="So we can write back" required />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" placeholder="What's on your mind?" required></textarea>
      </div>
      <button type="submit" class="submit-btn">Send it →</button>
    </form>
 
    <div class="form-success" id="formSuccess">
      ✓ Message received — we'll be in touch soon.
    </div>
  </section>
 
  <!-- FOOTER -->
  <footer>
    <strong>Elias, Oli & Georgia</strong> &nbsp;·&nbsp; Made with care
  </footer>
 
  <script>
    // Scroll-triggered animations for contact section
    const section = document.querySelector('.contact-section');
    const observer = new IntersectionObserver(
      ([entry]) => { if (entry.isIntersecting) section.classList.add('visible'); },
      { threshold: 0.15 }
    );
    observer.observe(section);
 
    // Form AJAX submission (works with Formspree)
    const form = document.getElementById('contactForm');
    const success = document.getElementById('formSuccess');
 
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' }
      });
      if (res.ok) {
        form.style.display = 'none';
        success.style.display = 'block';
      }
    });
  </script>
 
</body>
</html>
 
